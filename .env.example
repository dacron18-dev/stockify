# ---- Browser (safe to expose): set these in Vercel -> Settings -> Environment Variables ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- Server only (used by api/update-prices.js). NEVER prefix these with VITE_ ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-SERVICE-ROLE-KEY
PRICE_PROVIDER=yahoo              # yahoo (no key needed), indianapi, finnhub or twelvedata
INDIANAPI_KEY=                    # only when PRICE_PROVIDER=indianapi (indianapi.in)
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
PRICE_REFRESH_SECONDS=60
CRON_SECRET=any-long-random-string  # lets an external scheduler call the endpoint
